monsterStartNumber = 1000;
renderPeriod = 10;
monsterRenderDistance = 300;
monsterAppearanceDistance = 100;
monsterChunkSize = 100;
monsterHouseDensityCoef = 1;
monsterHouseSpawnChance = 0.3;
monsterRoadSpawnChance = 0.3;
monsterTargetDistaceCoef = -1;
dayStart = 5;
nightStart = 19.5;

monsters = [];
isDay = nil;

_markersEnabled = False;

_fn_calculateChunkWeight = {
    params ["_nearHousesCount", "_nearRoadsCount"];
    1 - (1 + _nearHousesCount) ^ -monsterHouseDensityCoef;
};

_chunks = [monsterChunkSize, _fn_calculateChunkWeight] call fn_buildChunks;

_fn_getRandomPos = {
    _chunk = [_chunks] call fn_selectRandomChunk;
    [_chunk, monsterHouseSpawnChance, monsterRoadSpawnChance] call fn_selectRandomPosInChunk;
};

_fn_getRandomNearPos = {
    params ["_pos"];
    _chunk = [_chunks, _pos, monsterTargetDistaceCoef] call fn_selectRandomNearChunk;
    [_chunk, monsterHouseSpawnChance, monsterRoadSpawnChance] call fn_selectRandomPosInChunk;
};

for "_m" from 0 to monsterStartNumber - 1 do {
    _mPos = call _fn_getRandomPos;
    _mLogic = createVehicle ["Land_VR_Shape_01_cube_1m_F", _mPos, [], 0, "NONE"];
    _mLogic enableSimulationGlobal false;
    _mLogic hideObjectGlobal true;
    _mTargetPos = [_mPos] call _fn_getRandomNearPos;
    _mTarget = createVehicle ["Land_VR_Shape_01_cube_1m_F", _mTargetPos, [], 0, "NONE"];
    _mTarget enableSimulationGlobal false;
    _mTarget hideObjectGlobal true;
    _mType = [monsterTypes] call fn_selectWeightedRandom;
    _mMarker = objNull;
    _mTargetMarker = objNull;
    if (_markersEnabled) then {
        _mMarker = createMarker [format ['monster_%1', _mPos], _mPos];
        _mMarker setMarkerType "mil_arrow_noShadow";
        _mMarker setMarkerColor "colorIndependent";
        _mTargetMarker = createMarker [format ['target_%1', _mTargetPos], _mTargetPos];
        _mTargetMarker setMarkerType "mil_unknown_noShadow";
        _mTargetMarker setMarkerColor "colorIndependent";
    };
    _monster = [_mLogic, objNull, _mMarker, _mTarget, _mTargetMarker, _mType];
    monsters pushBack _monster;
};

while {true} do {
    if (dayTime >= dayStart && dayTime < nightStart) then {
        isDay = True;
    } else {
        isDay = False;
    };

    _deadMonsters = [];
    for "_m" from 0 to count monsters - 1 do {
        _monster = monsters select _m;
        _mLogic = _monster select 0;
        _mObject = _monster select 1;
        _mMarker = _monster select 2;
        _mTarget = _monster select 3;
        _mTargetMarker = _monster select 4;
        _mType = _monster select 5;
        _mClasses = _mType select 0;
        _mSpeed = _mType select 1;
        _mDayTime = _mType select 2;
        _mNightTime = _mType select 3;
        _isRendered = !isNull _mObject;
        _mustBeRendered = False;
        _canAppear = True;
        {
            _distance = _x distance2D _mLogic;
            if (_distance < monsterRenderDistance) then {
                _mustBeRendered = True;
                if (_distance < monsterAppearanceDistance) then {
                    _canAppear = False;
                };
            };
        } forEach playableUnits;

        if (_isRendered) then {
            _mLogic setPos getPos _mObject;
            _mLogic setDir getDir _mObject;
            if (_markersEnabled) then {
                _mMarker setMarkerPos getPos _mObject;
                _mMarker setMarkerDir getDir _mObject;
            };
            if (alive _mObject) then {
                if (!_mustBeRendered) then {
                    deleteVehicle _mObject;
                    _monster set [1, objNull];
                };
            } else {
                _deadMonsters pushBack _m;
            };
        } else {
            if (_mDayTime && isDay || _mNightTime && !isDay) then {
                _mPos = (getPos _mLogic);
                if (_mustBeRendered && _canAppear) then {
                    _mClass = selectRandom _mClasses;
                    _mGroup = createGroup [independent, true];
                    _mObject = _mGroup createUnit [_mClass, _mLogic, [], 0, "NONE"];
                    _mObject setDir getDir _mLogic;
                    _mGroup selectLeader _mObject;
                    _mWp = _mGroup addWaypoint [_mTarget, -1];
                    _mWp setWaypointType "SAD";
                    _monster set [1, _mObject];
                } else {
                    _stepSize = (_mSpeed * renderPeriod);
                    _targetVector = (getPos _mTarget) vectorDiff _mPos;
                    _stepVector = [];
                    if (vectorMagnitude _targetVector <= _stepSize) then {
                        _stepVector = _targetVector;
                        _mTargetPos = [_mPos] call _fn_getRandomNearPos;
                        _mTarget setPos _mTargetPos;
                        if (_markersEnabled) then {
                            _mTargetMarker setMarkerPos _mTargetPos;
                        };
                    } else {
                        _stepVector = (vectorNormalized _targetVector) vectorMultiply _stepSize;
                    };
                    _mPos = _mPos vectorAdd _stepVector;
                    _mLogic setPos _mPos;
                    _mLogic setVectorDir _stepVector;
                    if (_markersEnabled) then {
                        _mMarker setMarkerPos _mPos;
                        _mMarker setMarkerDir getDir _mLogic;
                    };
                };
            };
        };
    };

    for "_i" from 0 to count _deadMonsters - 1 do {
        _m = (_deadMonsters select _i) - _i;
        _monster = monsters select _m;
        _mLogic = _monster select 0;
        _mObject = _monster select 1;
        _mMarker = _monster select 2;
        _mTarget = _monster select 3;
        _mTargetMarker = _monster select 4;

        deleteVehicle _mLogic;
        deleteVehicle _mTarget;

        if (_markersEnabled) then {
            _mMarker setMarkerType "mil_dot_noShadow";
            deleteMarker _mTargetMarker;
        };

        monsters deleteAt _m;
    };
    sleep renderPeriod;
};
